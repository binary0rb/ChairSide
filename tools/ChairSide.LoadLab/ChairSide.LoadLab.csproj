<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChairSide.LoadLab</RootNamespace>
    <AssemblyName>ChairSide.LoadLab</AssemblyName>
    <!-- Suppress the XML doc warning - this is a dev tool, not a library -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
